# ChatShy 环境变量（仅作初始引导；运行时设置改存数据库 settings 表）
# 复制为 .env 后按需修改；.env 已被 gitignore，不会入库。

PORT=8088

# 监听地址；默认 0.0.0.0，本机经 nginx 反代时可设 127.0.0.1
# HOST=127.0.0.1

# SQLite 数据库文件路径（相对当前工作目录）
DB_PATH=./data/chatshy.db

# 管理员初始密码；留空或不设置则首次启动随机生成并打印到日志。
# 注意：仅在数据库中还没有管理员密码哈希时生效，之后改密码请走操作台设置页。
ADMIN_PASSWORD=

# 全局调用方 Key（所有调用方共用这一个）；留空则首次启动随机生成并打印到日志。
# 之后可在操作台设置页查看/重新生成，那边的值优先。
CALLER_KEY=

# 全局默认挂起超时（毫秒）
DEFAULT_TIMEOUT_MS=180000

# GET /v1/models 展示的模型名（响应中 model 字段一律回显请求值）
MODEL_NAME=chatshy

# SSE 保活间隔（毫秒）：网关流式挂起期间发 ping 的频率
# SSE_PING_MS=15000
# 操作台事件流 ping 间隔（毫秒）
# HUB_PING_MS=20000
# 打字机帧间隔（毫秒）；设为 0 表示分帧但不等待
# TYPEWRITER_TICK_MS=25

# ---- 豆奶页面（与网关同一个进程，额外监听 8099）----
# 是否随 chatshy 一起启动豆奶站点
DOUNAI_ENABLED=true
DOUNAI_PORT=8099
DOUNAI_HOST=127.0.0.1
# 豆奶作为调用方时在操作台显示的名字（X-ChatShy-Caller）
DOUNAI_CALLER=豆奶
# 可选：每次请求前置的 system 提示词
DOUNAI_SYSTEM_PROMPT=
# 豆奶转发的网关地址；留空则用 http://127.0.0.1:${PORT}/v1
DOUNAI_UPSTREAM_BASE_URL=
