# ChatShy 环境变量（仅作初始引导；运行时设置改存数据库 settings 表）
# 复制为 .env 后按需修改；.env 已被 gitignore，不会入库。

PORT=8088
# SQLite 数据库文件路径（相对当前工作目录）
DB_PATH=./data/chatshy.db

# 管理员初始密码；留空或不设置则首次启动随机生成并打印到日志。
# 注意：仅在数据库中还没有管理员密码哈希时生效，之后改密码请走操作台设置页。
ADMIN_PASSWORD=

# 全局调用方 Key（所有调用方共用这一个）；留空则首次启动随机生成并打印到日志。
# 之后可在操作台设置页查看/重新生成，那边的值优先。
CALLER_KEY=

# 全局默认挂起超时（毫秒）
DEFAULT_TIMEOUT_MS=180000

# GET /v1/models 展示的模型名（响应中 model 字段一律回显请求值）
MODEL_NAME=chatshy
